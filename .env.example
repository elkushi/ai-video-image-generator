# Copy to .env and fill in. Keep variable names in sync with .env.
# Every service here is FREE. Never add a paid provider to this project.

# Stock video/photos - free key: https://www.pexels.com/api/  (200 req/h)
# PEXELS_API_KEY=
# Stock video/photos - free key: https://pixabay.com/api/docs/  (cache 24h, show source)
# PIXABAY_API_KEY=
# Hugging Face read token - free account: https://huggingface.co/settings/tokens
# Raises the free ZeroGPU quota for AI images, clips, avatars, MusicGen.
# HF_TOKEN=

# ---- Factory app / Docker deployment (all optional) ----
# FACTORY_HOST=127.0.0.1          # the container sets 0.0.0.0 itself; keep 127.0.0.1 on a bare host
# FACTORY_PORT=8787
# FACTORY_LOCAL_PORT=8787         # host port docker compose binds on 127.0.0.1
# FACTORY_MODEL=                  # empty = your Claude Code default model
# FACTORY_OFFLINE=1               # local models only (no anonymous free online providers)
#
# Claude auth for the headless jobs. No API key needed: each deployment uses its own Claude subscription.
#   Option A: run `claude setup-token` on any machine with a browser (Claude Code installed, or
#             `make token`) and paste the long-lived token here.
# CLAUDE_CODE_OAUTH_TOKEN=
#   Option B: leave it empty and log the container in once: `docker compose exec -it factory claude auth login`
#             (`make login`); the login is kept in the claude-config volume (CLAUDE_CONFIG_DIR).
#   Optional alternative, billed per use and it takes precedence over the subscription when set:
# ANTHROPIC_API_KEY=
#
# Invite-only beta behind HTTPS (docker compose --profile public up -d). See deploy/Caddyfile.
# Invitees are in deploy/users.caddy (make invite NAME=alice), not here.
# FACTORY_DOMAIN=factory.example.com
# Build the image with your host uid/gid in laptop mode (make up-local sets these for you).
# APP_UID=1000
# APP_GID=1000
